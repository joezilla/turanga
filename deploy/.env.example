# Copy to deploy/.env (gitignored — AD-10). Do NOT commit real secrets.
POSTGRES_PASSWORD=turanga
LITELLM_MASTER_KEY=sk-turanga-dev
# Encrypts provider keys stored in LiteLLM. Set once; never change once models exist.
LITELLM_SALT_KEY=sk-turanga-salt-dev
WEB_ORIGIN=http://localhost:5173

# Single-user login (seeded on first control-api boot if no user exists).
# REQUIRED to create a user — set a real password; the value below is a dev placeholder.
INITIAL_ADMIN_EMAIL=admin@turanga.local
INITIAL_ADMIN_PASSWORD=changeme-dev

# Set to true only when serving over HTTPS (production).
COOKIE_SECURE=false
